<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest overlay ที่ถูกรวมเข้าเฉพาะ debug build
  release build ไม่ได้ไฟล์นี้ จึงยังบล็อก HTTP ธรรมดาตามค่าเริ่มต้นของ Android

  ชี้ไป network_security_config.xml ที่อนุญาต cleartext เฉพาะ IP ใน LAN
  ตอน production แอปคุยกับ Vercel ผ่าน https อยู่แล้ว ไม่ต้องใช้ข้อยกเว้นนี้
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
