{
  "name": "cycle-count",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @cycle-count/db generate",
    "db:migrate": "pnpm --filter @cycle-count/db migrate",
    "db:seed": "pnpm --filter @cycle-count/db seed"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "eslint": "9",
    "globals": "15",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "8"
  }
}
