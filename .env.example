# ---- Database (Supabase Postgres) ----
# ใช้ connection string จาก Supabase (Settings > Database). แนะนำ pooler (port 6543) สำหรับ serverless
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# direct connection (port 5432) สำหรับ migration
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ---- Supabase (client / auth / storage) ----
# แนะนำสร้าง project ที่ region Singapore (ap-southeast-1) — ใกล้ไทยที่สุด (~30-50 ms)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-KEY]"
# service role: ใช้เฉพาะฝั่ง server เท่านั้น ห้าม expose ให้ client
# ใช้กับ Storage ของไฟล์ import — ต้องสร้าง bucket ชื่อ `imports` แบบ private ก่อน
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"

# ---- CORS สำหรับแอป PDA ----
# PDA อยู่คนละ origin กับเว็บ (Capacitor เสิร์ฟจาก https://localhost)
# ค่าใน list นี้จะถูกเพิ่มจาก default: https://localhost, http://localhost, http://localhost:5173
PDA_ALLOWED_ORIGINS=""

# ---- PDA app (Vite) ----
# ชี้ไปที่ URL ของ Admin web (API routes) เมื่อ build APK ให้ใช้ URL production
VITE_API_BASE_URL="http://localhost:3000"
VITE_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="[ANON-KEY]"
